# ==============================================================================
# SMRITI ENVIRONMENT CONFIGURATION TEMPLATE
# Platform: AI-Based Cognitive Gaming & Memory Assistance for Elderly Dementia (NER)
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Backend Authentication & Session Secret
SESSION_SECRET=smriti_secure_session_key_placeholder_change_in_production
AUTH_TOKEN_EXPIRY=7d

# Firebase / Google Cloud Project Config (Auth & Firestore)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Client-Side Firebase Config (Web SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase Storage Configuration (Private Binary Media Vault)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=smriti-media

# SIH Regional & Cultural Defaults
NER_DEFAULT_REGION=NER
DEFAULT_LANGUAGE=as

# ABDM (Ayushman Bharat Digital Mission) Configuration
# Leave blank or set ABDM_USE_MOCK=true to run in sandbox simulation mode
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_USE_MOCK=true

